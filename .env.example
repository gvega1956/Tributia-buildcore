# Database
# Rol admin (dueño de tablas — bypassa RLS). Usar para migraciones y seeds.
DATABASE_URL=postgresql://tributia:tributia_dev@localhost:5432/tributia_buildcore
# Rol de aplicación (sujeto a RLS). Usar para el runtime de la API.
DATABASE_URL_APP=postgresql://tributia_app:tributia_app_dev@localhost:5432/tributia_buildcore

# App
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# JWT
JWT_SECRET=change_this_in_production_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_too
JWT_REFRESH_EXPIRES_IN=7d

# Storage (MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=tributia
STORAGE_SECRET_KEY=tributia_dev
STORAGE_BUCKET=tributia-docs

# Redis
REDIS_URL=redis://localhost:6379
